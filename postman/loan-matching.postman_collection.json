{
  "info": {
    "name": "Lama Loan Matching",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Example 1: no lender matches",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"returns expected lenders\", () => pm.expect(pm.response.json()).to.eql([]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"borrowerType\": \"business\",\n  \"loanType\": \"Line Of Credit\",\n  \"state\": \"NY\",\n  \"riskLevel\": 90,\n  \"Industry\": \"agriculture\",\n  \"requestedAmount\": \"200000\",\n  \"currentYearIncome\": \"90000\",\n  \"previousYearIncome\": \"45000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/applicationMatch",
          "host": ["{{baseUrl}}"],
          "path": ["applicationMatch"]
        }
      }
    },
    {
