            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"names the invalid field\", () => pm.expect(pm.response.json().issues[0].path).to.eql([\"loanType\"]));"
            ]
